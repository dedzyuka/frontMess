    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Автоматически устанавливаем заголовок Authorization для всех запросов, кроме логина/регистрации",
                    "if (pm.request.url.path.includes('graphql') && pm.collectionVariables.get('access_token')) {",
                    "    pm.request.headers.add({",
                    "        key: 'Authorization',",
                    "        value: 'Bearer ' + pm.collectionVariables.get('access_token')",
                    "    });",
                    "}"
                ]
            }
        }
    ]
